# Copyright (C) 2025 kenrow214

on boot
    # GPU
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chown system system /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/governor
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0660 /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chmod 0440 /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/governor

    # Storage
    chown system system /sys/block/sda/queue/scheduler
    chown system system /sys/class/scsi_host/host0/../../../clkscale_enable
    chmod 0664 /sys/block/sda/queue/scheduler
    chmod 0664 /sys/class/scsi_host/host0/../../../clkscale_enable

    # CPU Little (policy0)
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us

    # CPU Big (policy4)
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us

    # CPU Prime (policy7)
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us

    # Core control
    chown system system /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
    chown system system /sys/devices/system/cpu/cpu7/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu7/core_ctl/min_cpus

    # Scheduler
    chown system system /proc/sys/kernel/sched_upmigrate
    chown system system /proc/sys/kernel/sched_downmigrate
    chown system system /proc/sys/kernel/sched_boost
    chmod 0664 /proc/sys/kernel/sched_upmigrate
    chmod 0664 /proc/sys/kernel/sched_downmigrate
    chmod 0664 /proc/sys/kernel/sched_boost

    # Input boost
    chown system system /sys/devices/system/cpu/cpu_boost/input_boost_freq
    chown system system /sys/devices/system/cpu/cpu_boost/input_boost_ms
    chmod 0664 /sys/devices/system/cpu/cpu_boost/input_boost_freq
    chmod 0664 /sys/devices/system/cpu/cpu_boost/input_boost_ms

    # Cpuset
    chown system system /dev/cpuset/foreground/cpus
    chown system system /dev/cpuset/background/cpus
    chown system system /dev/cpuset/system-background/cpus
    chown system system /dev/cpuset/restricted/cpus
    chmod 0664 /dev/cpuset/foreground/cpus
    chmod 0664 /dev/cpuset/background/cpus
    chmod 0664 /dev/cpuset/system-background/cpus
    chmod 0664 /dev/cpuset/restricted/cpus

    # LPM sleep
    chown system system /sys/module/lpm_levels/parameters/sleep_disabled
    chmod 0664 /sys/module/lpm_levels/parameters/sleep_disabled

    setprop sys.perf_mode_active ${persist.sys.perf_mode_saved:-1}

on property:sys.perf_mode_active=2
    write /sys/module/lpm_levels/parameters/sleep_disabled 1
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor performance
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor performance
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor performance
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 844800
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 917100
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2841600
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 676000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 840000000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 500
    write /proc/sys/kernel/sched_upmigrate "85 85"
    write /proc/sys/kernel/sched_downmigrate "70 70"
    write /proc/sys/kernel/sched_boost 1
    write /sys/devices/system/cpu/cpu_boost/input_boost_freq "0:1305600"
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 200
    write /sys/block/sda/queue/scheduler kyber
    write /sys/class/scsi_host/host0/../../../clkscale_enable 0

on property:sys.perf_mode_active=1
    write /proc/sys/vm/drop_caches 3
    write /sys/module/lpm_levels/parameters/sleep_disabled N
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor simple_ondemand
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710400
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844800
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2841600
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 315000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 840000000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 500
    write /proc/sys/kernel/sched_upmigrate "95 95"
    write /proc/sys/kernel/sched_downmigrate "85 85"
    write /proc/sys/kernel/sched_boost 0
    write /sys/devices/system/cpu/cpu_boost/input_boost_freq "0:1305600"
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 120
    write /sys/block/sda/queue/scheduler bfq
    write /sys/class/scsi_host/host0/../../../clkscale_enable 0

on property:sys.perf_mode_active=0
    write /sys/module/lpm_levels/parameters/sleep_disabled 0
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor userspace
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710400
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844800
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2212000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2592000
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 315000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 579000000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 40000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 30000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 10000
    write /proc/sys/kernel/sched_upmigrate "90 90"
    write /proc/sys/kernel/sched_downmigrate "85 85"
    write /proc/sys/kernel/sched_boost 0
    write /sys/devices/system/cpu/cpu_boost/input_boost_freq "0:1094400"
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 80
    write /sys/block/sda/queue/scheduler bfq
    write /sys/class/scsi_host/host0/../../../clkscale_enable 1

on property:persist.sys.parts.storage.scheduler=*
    write /sys/block/sda/queue/scheduler ${persist.sys.parts.storage.scheduler}

on property:persist.sys.parts.storage.clkscale=*
    write /sys/class/scsi_host/host0/../../../clkscale_enable ${persist.sys.parts.storage.clkscale}

on property:persist.sys.parts.gpu.min_frequency=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq ${persist.sys.parts.gpu.min_frequency}

on property:persist.sys.parts.gpu.max_frequency=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq ${persist.sys.parts.gpu.max_frequency}

on property:persist.sys.parts.gpu.governor=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor ${persist.sys.parts.gpu.governor}

on property:persist.sys.parts.cpu.little.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq ${persist.sys.parts.cpu.little.min_frequency}

on property:persist.sys.parts.cpu.little.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq ${persist.sys.parts.cpu.little.max_frequency}

on property:persist.sys.parts.cpu.little.governor=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ${persist.sys.parts.cpu.little.governor}

on property:persist.sys.parts.cpu.big.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq ${persist.sys.parts.cpu.big.min_frequency}

on property:persist.sys.parts.cpu.big.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq ${persist.sys.parts.cpu.big.max_frequency}

on property:persist.sys.parts.cpu.big.governor=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor ${persist.sys.parts.cpu.big.governor}

on property:persist.sys.parts.cpu.prime.min_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq ${persist.sys.parts.cpu.prime.min_frequency}

on property:persist.sys.parts.cpu.prime.max_frequency=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq ${persist.sys.parts.cpu.prime.max_frequency}

on property:persist.sys.parts.cpu.prime.governor=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor ${persist.sys.parts.cpu.prime.governor}