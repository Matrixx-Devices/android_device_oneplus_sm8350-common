<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header: Title + Mode + Temps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System Monitor"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textColor="#FF6C63FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#226C63FF"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <!-- Temperature Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_bat_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔋 --°C"
            android:textColor="#FF29B6F6"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_cpu_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🖥 --°C"
            android:textColor="#FF6C63FF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_gpu_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎮 --°C"
            android:textColor="#FF43E97B"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#22FFFFFF" />

    <!-- CPU Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="CPU"
            android:textColor="#FF6C63FF"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_cpu_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_cpu" />
        <TextView
            android:id="@+id/widget_cpu_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- GPU Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="GPU"
            android:textColor="#FF43E97B"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_gpu_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_gpu" />
        <TextView
            android:id="@+id/widget_gpu_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--MHz"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- RAM + SWAP Row (circular style via text) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="RAM"
            android:textColor="#FFFFA726"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_mem_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_mem" />
        <TextView
            android:id="@+id/widget_mem_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- SWAP Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="SWAP"
            android:textColor="#FFCE93D8"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_swap_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_cpu" />
        <TextView
            android:id="@+id/widget_swap_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Battery Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="BAT"
            android:textColor="#FF29B6F6"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_bat_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_bat" />
        <TextView
            android:id="@+id/widget_bat_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Storage Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="DISK"
            android:textColor="#FFEF5350"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_storage_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar_storage" />
        <TextView
            android:id="@+id/widget_storage_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
