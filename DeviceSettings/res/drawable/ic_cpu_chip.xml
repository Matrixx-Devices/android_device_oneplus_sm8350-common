    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M6,9.5 H3.5 M6,12 H3.5 M6,14.5 H3.5" />
    <!-- Right pins -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M18,9.5 H20.5 M18,12 H20.5 M18,14.5 H20.5" />
    <!-- Top pins -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M9.5,6 V3.5 M12,6 V3.5 M14.5,6 V3.5" />
    <!-- Bottom pins -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M9.5,18 V20.5 M12,18 V20.5 M14.5,18 V20.5" />
</vector>
